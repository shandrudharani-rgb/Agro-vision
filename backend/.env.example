PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/smart_agri
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
WEATHER_API_KEY=your_openweathermap_api_key
WEATHER_API_BASE=https://api.openweathermap.org/data/2.5
CLIENT_URL=http://localhost:3000

# Google Gemini API. Create a key in Google AI Studio and never expose it to the frontend.
GEMINI_API_KEY=your_google_gemini_api_key
# Change this value when promoting a newer Gemini model in your Google project.
GEMINI_MODEL=gemini-2.5-flash-lite

# Optional — official govt. market-price data (data.gov.in / AGMARKNET), used by
# the Live Market Price feature (/api/market-live).
# Get your own free key at https://data.gov.in (register -> My Account -> API keys).
# If left blank, the feature automatically uses data.gov.in's own PUBLIC SAMPLE KEY
# (published on their API docs for testing) so you still get real government data,
# just capped at ~10 records per search. Add your own key here for full results.
DATA_GOV_API_KEY=your_data_gov_in_api_key
